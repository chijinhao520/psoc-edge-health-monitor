+/* 清除结构体中的历史数据 */
+static void clear_str_data(aht10_data_t *data)
+{
+    data->cur_humi = 0.0f;
+    data->cur_temp = -50.0f;
+}
+
+/**
+ * @brief 读取传感器所有数据
+ *
+ * - 互斥锁保护
+ * - 采样后校验状态位
+ * - 异常时重新初始化并返回兜底值
+ */
+void read_sensor_data(aht10_device_t dev, aht10_data_t *data)
+{
+    rt_uint8_t temp[6];
+    rt_err_t result;
+
+    RT_ASSERT(dev);
+    RT_ASSERT(data);
+
+    clear_str_data(data); // 对结构体数据进行清空
+
+    result = rt_mutex_take(dev->lock, RT_WAITING_FOREVER);
+    if (result == RT_EOK)
+    {
+        rt_uint8_t cmd[2] = {0x33, 0x00};
+        write_reg(dev->i2c, AHT10_GET_DATA, cmd); // sample data cmd
+        rt_thread_mdelay(80); /* 等待测量完成，手册要求 ~75ms */
+
+        result = calibration_enabled(dev);
+        if (result != RT_EOK)
+        {
+            /* 这里的 "abnormal status" 主要表示校准状态位检查失败 */
+            rt_thread_mdelay(1500);
+            sensor_init(dev);
+            LOG_E("The aht10 is under an abnormal status. Please try again");
+        }
+        else
+        {
+            read_regs(dev->i2c, 6, temp); // get data
+            /* 传感器原始数据换算为相对湿度 */
+            data->cur_humi = (temp[1] << 12 | temp[2] << 4 | (temp[3] & 0xf0) >> 4) * 100.0 / (1 << 20);
+            /* 传感器原始数据换算为温度（摄氏度） */
+            data->cur_temp = ((temp[3] & 0xf) << 16 | temp[4] << 8 | temp[5]) * 200.0 / (1 << 20) - 50;
+        }
+    }
+    else
+    {
+        LOG_E("The aht10 could not respond any sensor data at this time. Please try again");
+    }
+    rt_mutex_release(dev->lock);
+}
