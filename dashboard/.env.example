# 复制成 .env 后填入真实值。.env 已被 .gitignore 忽略，不会进版本库。
# 服务器上更推荐直接用环境变量 / systemd EnvironmentFile，真实环境变量优先于本文件。

# DeepSeek API key（不配则 AI 报告功能关闭，其余功能正常）
# 控制台：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# 以下均可选，留空用默认值
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# MQTT_BROKER=localhost
# MQTT_PORT=1883
